  },
  {
    "name": "Arabic diacritics are removed only when configured",
    "type": "answer",
    "input": "\u0645\u064f\u062f\u064e\u0631\u0650\u0651\u0633",
    "settings": { "diacritic_sensitive": false },
    "expected": "\u0645\u062f\u0631\u0633"
  },
  {
    "name": "case can remain sensitive when configured",
    "type": "answer",
    "input": "CAF\u00c9",
